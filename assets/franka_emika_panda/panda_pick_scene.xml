<mujoco model="panda_pick_scene">
  <include file="panda_local.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="130" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true" castshadow="false"/>
    <geom name="floor" type="plane" pos="0 0 -0.4" size="0 0 0.05" material="groundplane"/>
    <geom name="table" type="box" pos="0.3 0 -0.2" size="0.5 0.4 0.2" rgba="0.25 0.25 0.28 1"/>
    <!--geom name="drop_zone" type="box" pos="0.5 -0.2 0.0005" size="0.04 0.04 0.0005"
          rgba="0.1 0.8 0.2 1" contype="0" conaffinity="0"/-->

    <camera name="agentview" pos="1.1 0 0.7" xyaxes="0 1 0 -0.7 0 0.6" fovy="50"/>
    <!--camera name="agentview" pos="0.5 -1.1 0.6" xyaxes="1 0 0 0 0.5 1.1" fovy="50"/-->

    <body name="red_box" pos="0.5 0.2 0.02">
      <freejoint name="red_box_joint"/>
      <geom name="red_box_geom" type="box" size="0.02 0.02 0.02"
            mass="0.05" rgba="1 0 0 1" friction="1.5 0.005 0.0001"/>
    </body>
    <body name="blue_box" pos="0.4 0.1 0.02">
      <freejoint name="blue_box_joint"/>
      <geom name="blue_box_geom" type="box" size="0.02 0.02 0.02"
            mass="0.05" rgba="0 0 1 1" friction="1.5 0.005 0.0001"/>
    </body>
    <body name="white_box" pos="0.6 0.0 0.02">
      <freejoint name="white_box_joint"/>
      <geom name="white_box_geom" type="box" size="0.02 0.02 0.02"
            mass="0.05" rgba="1 1 1 1" friction="1.5 0.005 0.0001"/>
    </body>

    <body name="green_zone" mocap="true" pos="0.5 -0.2 0.0005">
      <geom type="box" size="0.04 0.04 0.0005" rgba="0.1 0.8 0.2 1" contype="0" conaffinity="0"/>
    </body>
    <body name="pink_zone" mocap="true" pos="0.5 0.3 0.0005">
      <geom type="box" size="0.04 0.04 0.0005" rgba="1 0.3 0.7 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>